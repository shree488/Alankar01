# Backend Environment Variables
# Copy this file to .env and fill in the values

# MongoDB connection
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# Owner portal authentication
ADMIN_PASSWORD="your_admin_password_here"
JWT_SECRET="generate_a_random_hex_string_here"

# Frontend URL (for CORS and cookie settings)
FRONTEND_URL="http://localhost:3000"
CSRF_TRUSTED_ORIGINS="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Emergent Object Storage (optional - image uploads won't work without these)
INTEGRATION_PROXY_URL="https://integrations.emergentagent.com"
EMERGENT_LLM_KEY="your_emergent_key_here"
STORAGE_APP_NAME="new-alankar-jewellers"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_URL=http://localhost:3000
