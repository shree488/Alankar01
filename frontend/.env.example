# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:8000

# Health check (set to "true" to enable webpack health plugin)
ENABLE_HEALTH_CHECK=false

# Google Maps integration
REACT_APP_SHOWROOM_MAP_EMBED_URL="https://www.google.com/maps/embed?origin=mfe&pb=!1m3!3m2!1m1!4s212567386023066494!3m1!1smr!5m1!1smr"
REACT_APP_SHOWROOM_MAP_URL="https://share.google/ssEBGfxWdCO83eUnt"
REACT_APP_SHOWROOM_DIRECTIONS_URL="https://www.google.com/maps/dir/?api=1&destination=17.0373931%2C74.6029575"
